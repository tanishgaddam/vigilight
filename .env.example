# Copy this file to .env and fill in what you use. Never commit .env.

# --- Alert channels (all optional, use any combination) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# ntfy.sh push notifications to your phone: install the ntfy app and subscribe to this topic
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
MQTT_ENABLED=true
MQTT_BROKER=broker.hivemq.com
MQTT_TOPIC=sfit/vigilight/alerts

# --- Models ---
# Knife/gun model. Leave empty to auto-use weights/weapons.pt (written by train_weapons.py).
WEAPON_MODEL=
WEAPON_IMGSZ=960
WEAPON_KEEP_COCO=false
# DEVICE=0 uses the first GPU, DEVICE=cpu forces CPU, empty = automatic
DEVICE=

# --- Behaviour tuning ---
THREAT_THRESHOLD=0.60
WARNING_THRESHOLD=0.35
PROCESS_FPS=8
AUDIO_ENABLED=true
AUDIO_THRESHOLD=0.5
SAVE_CLIPS=true
